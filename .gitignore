__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
*.egg-info/

# A user's own live enrollments and feedback are personal/biometric-
# adjacent data generated at runtime -- never commit them
# (see /data-docs/consent.md).
backend/data/*.json
# ...except the shipped library: it's built offline from a licensed/public
# dataset via ml-model/import_dataset.py, not from anyone using the app,
# so it's meant to be committed and distributed with the repo. See
# backend/app/storage.py's module docstring.
!backend/data/library.json

# Downloaded MediaPipe model asset (cached on first server-side-detection
# use; large binary, re-downloadable, never hand-edited) -- see
# backend/app/landmarks.py.
backend/models/*.task

.DS_Store
